# ============================================================
# VARIABLES DE ENTORNO PARA DOCKER COMPOSE - SISTEMA CAMPOLARGO
# Copiar este archivo como .env (en la RAÍZ del proyecto) solo si se
# levanta el sistema con Docker (npm run docker:dev / docker:prod).
# Para correrlo sin Docker se usan backend/.env y frontend/.env (ver
# backend/.env.ejemplo y frontend/.env.ejemplo).
# NUNCA subir el archivo .env al repositorio
# ============================================================

# --- BASE DE DATOS ---
POSTGRES_DB=campolargo
POSTGRES_USER=campolargo_admin
POSTGRES_PASSWORD=campolargo2026_seguro
POSTGRES_PORT=5432

# --- BACKEND ---
# Puerto publicado en el equipo (docker-compose lo pasa al backend como PUERTO)
BACKEND_PUERTO=3001
JWT_SECRETO=cambiar_por_clave_segura_minimo_32_caracteres
JWT_SECRETO_REFRESH=cambiar_por_clave_refresh_segura_minimo_32_caracteres
JWT_EXPIRACION=15m
JWT_EXPIRACION_REFRESH=7d

# --- EMAIL (Nodemailer) ---
# EMAIL_CLAVE es una contraseña de aplicación de Gmail (Cuenta de Google →
# Seguridad → Verificación en dos pasos → Contraseñas de aplicaciones),
# no la contraseña normal de la cuenta.
EMAIL_SERVIDOR=smtp.gmail.com
EMAIL_PUERTO=587
EMAIL_USUARIO=sucesioncampolargo@gmail.com
EMAIL_CLAVE=clave_de_aplicacion_gmail
EMAIL_REMITENTE=sucesioncampolargo@gmail.com

# --- FRONTEND ---
FRONTEND_PUERTO=5173
VITE_API_URL=http://localhost:3001/api

# --- PRODUCCIÓN ---
URL_FRONTEND=https://campolargo.com
NODE_ENV=development
