# ============================================================
# BACKEND - SISTEMA CAMPOLARGO
# Copiar este archivo como backend/.env y completar los valores.
# NUNCA subir el archivo .env al repositorio.
# ============================================================

# --- BASE DE DATOS ---
# Formato: postgresql://usuario:contraseña@host:puerto/base_datos
DATABASE_URL="postgresql://postgres:CONTRASEÑA@localhost:5432/campolargo"
# Obligatoria (el schema de Prisma la exige). En local va igual que
# DATABASE_URL; solo cambia si DATABASE_URL apunta a un pooler (p. ej. Neon),
# porque `prisma migrate` necesita una conexión directa.
DIRECT_URL="postgresql://postgres:CONTRASEÑA@localhost:5432/campolargo"

# --- SERVIDOR ---
# Puerto de la API (por defecto 3001). En Render se usa PORT, que manda.
PUERTO=3001
NODE_ENV=development
# Origen permitido por CORS (dirección del frontend)
URL_FRONTEND=http://localhost:5173

# --- AUTENTICACIÓN (JWT) ---
# Mínimo 32 caracteres, aleatorias y DISTINTAS entre sí. Para generarlas:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRETO=reemplazar_por_clave_aleatoria_de_minimo_32_caracteres
JWT_SECRETO_REFRESH=reemplazar_por_otra_clave_aleatoria_distinta_32_caracteres
JWT_EXPIRACION=15m
JWT_EXPIRACION_REFRESH=7d

# --- CORREO (opcional) ---
# Sin EMAIL_USUARIO el sistema funciona igual, solo que no envía correos.
# EMAIL_CLAVE es una contraseña de aplicación de Gmail (Cuenta de Google →
# Seguridad → Verificación en dos pasos → Contraseñas de aplicaciones).
# EMAIL_SERVIDOR=smtp.gmail.com
# EMAIL_PUERTO=587
# EMAIL_USUARIO=tu_correo@gmail.com
# EMAIL_CLAVE=clave_de_aplicacion_gmail
# EMAIL_REMITENTE=tu_correo@gmail.com
