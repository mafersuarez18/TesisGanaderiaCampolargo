{
  "name": "campolargo-backend",
  "version": "1.0.0",
  "description": "API REST del Sistema de Gestión Veterinaria - Sucesión Joao Campolargo",
  "private": true,
  "main": "dist/servidor.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/servidor.ts",
    "construir": "tsc",
    "iniciar": "node dist/servidor.js",
    "db:migrar": "prisma migrate dev",
    "db:migrar:prod": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:datos-indicadores": "tsx prisma/datosPruebaIndicadores.ts",
    "db:reset": "prisma migrate reset --force && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generar": "prisma generate",
    "lint": "eslint src --ext .ts",
    "swagger:generar": "tsx src/docs/generarSwagger.ts"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
